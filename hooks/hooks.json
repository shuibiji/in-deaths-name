      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run-bun.cmd\" \"${CLAUDE_PLUGIN_ROOT}/scripts/in-deaths-name-rules.ts\" --client claude",
            "timeout": 300
          }
        ]
      }
